# === Bi mat ===
.env
.env.*
!.env.example
wp-config.php

# === Loi WordPress: khong commit, cai lai bang ban tai ve ===
/wp-admin/
/wp-includes/
/index.php
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html

# === wp-content: chi commit code CUA MINH ===
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/nntm/
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/nntm-*/

# deployment/soketi/docker-compose.yml (ban that, co APP_KEY/APP_SECRET
# that cua Soketi) bi loai; docker-compose.example.yml (ban mau
# CHANGE_ME_*) van len git de tham khao. Cung nguyen tac voi .env/.env.example.
deployment/soketi/docker-compose.yml

# Du lieu chay
!/wp-content/uploads/
/wp-content/cache/
/wp-content/upgrade*/
/wp-content/languages/
/wp-content/debug.log

# === Build ===
node_modules/
!vendor/
dist/
*.log

# === Figma cache (keo ve tu API) ===
/design/raw/
/design/.chrome-audit/

# === OS ===
Thumbs.db
Desktop.ini
.DS_Store

# File rac ten "nul" o goc thu muc — ten thiet bi danh rieng cua Windows,
# lam gay "git add -A" (mmap failed) neu vo tinh dinh vao.
/nul

# Python bytecode cua tools/embed-service
__pycache__/
*.pyc

# PDF demo sinh boi tools/tao-pdf-demo.py
/tools/pdf-demo/
