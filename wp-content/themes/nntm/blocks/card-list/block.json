{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nntm/card-list",
	"title": "Danh sách thẻ (Card List)",
	"category": "nntm",
	"icon": "layout",
	"description": "Danh sách thẻ nội dung ghép thành một section — khối xương sống ghép nên các trang phân mục. Khách tự chọn nguồn bài, biến thể thẻ, số cột và cách sắp xếp, không cần lập trình viên.",
	"textdomain": "nntm",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"customClassName": true,
		"anchor": true
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Tiêu đề mục"
		},
		"postType": {
			"type": "string",
			"enum": [
				"nntm_article",
				"nntm_publication",
				"nntm_talk",
				"nntm_retreat",
				"nntm_abode",
				"nntm_video",
				"nntm_zen_track",
				"nntm_chuyen_thay_toi",
				"post"
			],
			"default": "nntm_article"
		},
		"taxonomy": {
			"type": "string",
			"default": ""
		},
		"termId": {
			"type": "number",
			"default": 0
		},
		"variant": {
			"type": "string",
			"enum": [
				"article",
				"small",
				"xs",
				"dai-si",
				"kim-cuong",
				"article-hover",
				"video",
				"khoa-tu",
				"books"
			],
			"default": "article"
		},
		"columns": {
			"type": "number",
			"enum": [
				2,
				3,
				4
			],
			"default": 3
		},
		"postsPerPage": {
			"type": "number",
			"default": 6
		},
		"orderBy": {
			"type": "string",
			"enum": [
				"newest",
				"oldest",
				"title",
				"manual"
			],
			"default": "newest"
		},
		"manualOrderIds": {
			"type": "string",
			"default": ""
		},
		"excludePostId": {
			"type": "number",
			"default": 0,
			"description": "Loai tru mot bai khoi danh sach (vd: bai dang xem o dai 'Bai viet lien quan', tranh no tu liet ke chinh no)."
		},
		"showPaging": {
			"type": "boolean",
			"default": false
		},
		"subheading": {
			"type": "string",
			"default": ""
		},
		"showViewAll": {
			"type": "boolean",
			"default": false
		},
		"viewAllLabel": {
			"type": "string",
			"default": "Xem tất cả"
		},
		"viewAllUrl": {
			"type": "string",
			"default": "",
			"description": "Ghi de duong dan 'Xem tat ca'. De trong thi tu lay theo kho luu tru cua post type / term dang loc (hanh vi cu). Dung khi muon tro sang mot Page rieng (vd /nghi-quy/)."
		},
		"layout": {
			"type": "string",
			"enum": [
				"grid",
				"carousel",
				"marquee"
			],
			"default": "grid",
			"description": "grid = luoi (cu, mac dinh). carousel = bang the cuon co nut mui ten + thanh cuon (dung cho noi khac, KHONG duoc doi hanh vi). marquee = bang TU CHAY lien tuc, KHONG nut bam, KHONG thanh cuon (them 14/08/2026 cho dai Nghi Quy trang Kim Cuong Hanh Gia — xem inc/render-card-list-marquee.php)."
		},
		"autoplay": {
			"type": "boolean",
			"default": true
		},
		"autoplayInterval": {
			"type": "number",
			"default": 6,
			"minimum": 2,
			"maximum": 20
		},
		"background": {
			"type": "string",
			"enum": [
				"none",
				"kem",
				"cam",
				"toi",
				"cham",
				"vang"
			],
			"default": "none"
		},
		"starEffect": {
			"type": "boolean",
			"default": false,
			"description": "Bat hieu ung sao vang lap lanh phu tren nen cua rieng block Card List nay."
		},
		"enableQuiz": {
			"type": "boolean",
			"default": false,
			"description": "Bat popup cau hoi khi bam vao an pham Nghi Quy da duoc dat che do Quiz Required."
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"showCategory": {
			"type": "boolean",
			"default": true
		},
		"showCardCta": {
			"type": "boolean",
			"default": false
		},
		"cardCtaLabel": {
			"type": "string",
			"default": "Xem thêm"
		},
		"headingAbove": {
			"type": "string",
			"default": ""
		},
		"captionBelow": {
			"type": "string",
			"default": ""
		},
		"spotifyUrl": {
			"type": "string",
			"default": ""
		},
		"youtubeUrl": {
			"type": "string",
			"default": ""
		},
		"appleMusicUrl": {
			"type": "string",
			"default": "",
			"description": "Duong dan Apple Music. Chi hien bieu tuong Apple Music khi o nay co gia tri."
		},
		"videoSource": {
			"type": "string",
			"enum": [
				"posts",
				"youtube"
			],
			"default": "posts"
		},
		"youtubeItems": {
			"type": "string",
			"default": "https://www.youtube.com/watch?v=gJAbDSse5WM&list=RDgJAbDSse5WM&start_radio=1",
			"description": "LINK TAM (mau) do anh Uy chot 13/08/2026 - se thay bang danh sach that khi khach gui. Moi khoi card-list moi chen vao trang deu co san 1 dong video mau nay de chay ngay."
		}
	},
	"editorScript": "file:./editor.js",
	"viewScript": [
		"file:./view.js",
		"file:./view-paging.js",
		"file:./view-marquee-nav.js"
	],
	"style": [
		"file:./style.css",
		"file:../card/style.css"
	],
	"render": "file:./render.php"
}
