{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nntm/article-mosaic",
	"title": "Bố cục tạp chí (Article Mosaic)",
	"category": "nntm",
	"icon": "grid-view",
	"description": "1 bài nổi bật cột trái + 2 thẻ vừa và 3 thẻ nhỏ cột phải, tổng 6 bài — dùng cho SECTION Hoằng Pháp / Tin Tức (Figma: 05. HOA KHAI). Ít bài hơn 6 vẫn không vỡ bố cục.",
	"textdomain": "nntm",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"customClassName": true
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Hoằng Pháp"
		},
		"postType": {
			"type": "string",
			"enum": [ "post", "nntm_article", "nntm_publication", "nntm_talk", "nntm_video" ],
			"default": "post"
		},
		"taxonomy": {
			"type": "string",
			"default": ""
		},
		"termId": {
			"type": "number",
			"default": 0
		},
		"leadMedia": {
			"type": "string",
			"enum": [ "tall", "short" ],
			"default": "tall"
		},
		"secondaryLayout": {
			"type": "string",
			"enum": [ "mosaic", "grid" ],
			"default": "mosaic"
		},
		"orderBy": {
			"type": "string",
			"enum": [ "newest", "oldest", "title", "manual" ],
			"default": "newest"
		},
		"manualOrderIds": {
			"type": "string",
			"default": ""
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"showCategory": {
			"type": "boolean",
			"default": true
		},
		"viewAllLabel": {
			"type": "string",
			"default": ""
		},
		"viewAllUrl": {
			"type": "string",
			"default": ""
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"ctaLabel": {
			"type": "string",
			"default": "Xem thêm"
		}
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
