{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nntm/article-feature",
	"title": "Bài nổi bật toàn văn",
	"category": "nntm",
	"icon": "format-quote",
	"description": "Một bài viết trải rộng: dấu ngoặc kép lớn + tiêu đề + dòng trích nguồn in nghiêng, thân bài đặt trong khung nền kem kèm nút \"Xem tiếp\", ảnh lớn bên cạnh. Dùng cho khối bài nổi bật của trang chủ (Figma R4, 01_HOMEPAGE y=1602).",
	"textdomain": "nntm",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"customClassName": true,
		"anchor": true
	},
	"attributes": {
		"postId": {
			"type": "number",
			"default": 0
		},
		"postType": {
			"type": "string",
			"enum": [
				"post",
				"nntm_article",
				"nntm_publication",
				"nntm_talk"
			],
			"default": "post"
		},
		"taxonomy": {
			"type": "string",
			"default": ""
		},
		"termId": {
			"type": "number",
			"default": 0
		},
		"attribution": {
			"type": "string",
			"default": ""
		},
		"maxParagraphs": {
			"type": "number",
			"default": 8
		},
		"ctaLabel": {
			"type": "string",
			"default": "Xem tiếp"
		},
		"mediaPosition": {
			"type": "string",
			"enum": [
				"left",
				"right"
			],
			"default": "right"
		},
		"showQuoteMark": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
