{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nntm/cta",
	"title": "Nút kêu gọi hành động (CTA)",
	"category": "nntm",
	"icon": "button",
	"description": "Nút CTA theo component set CTA trong Figma. Chỉ 4 biến thể chọn được (Default, Ghost, CTA Text, Fav Button) — HOVER/GHOST HOVER/TEXT HOVER trong Figma là trạng thái rê chuột, viết bằng CSS chứ không phải biến thể riêng.",
	"textdomain": "nntm",
	"supports": {
		"html": false,
		"align": false,
		"customClassName": true
	},
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [ "default", "ghost", "cta-text", "fav-button" ],
			"default": "default"
		},
		"text": {
			"type": "string",
			"default": "Xem thêm"
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"opensInNewTab": {
			"type": "boolean",
			"default": false
		},
		"ariaLabel": {
			"type": "string",
			"default": ""
		},
		"objectId": {
			"type": "number",
			"default": 0
		},
		"favorited": {
			"type": "boolean",
			"default": false
		}
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
