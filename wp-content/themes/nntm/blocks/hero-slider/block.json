{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nntm/hero-slider",
	"title": "Băng chuyền đầu trang chủ (Hero Slider)",
	"category": "nntm",
	"icon": "images-alt2",
	"description": "Băng chuyền ảnh lớn đầu trang chủ, chữ đè lên ảnh, tự chạy. Khách tự thêm/xoá/sắp lại từng tấm, chỉnh thẻ nhỏ góc phải và dải liên kết nhanh trong bảng điều khiển bên phải, không cần lập trình viên. Dùng cho ảnh thiết kế trang chủ 1366x648.",
	"textdomain": "nntm",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"customClassName": true,
		"anchor": true
	},
	"attributes": {
		"slides": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"imageId": {
						"type": "number"
					},
					"imageUrl": {
						"type": "string"
					},
					"imageAlt": {
						"type": "string"
					},
					"heading": {
						"type": "string"
					},
					"text": {
						"type": "string"
					},
					"ctaLabel": {
						"type": "string"
					},
					"ctaUrl": {
						"type": "string"
					}
				}
			}
		},
		"autoplay": {
			"type": "boolean",
			"default": true
		},
		"arrowsEnabled": {
			"type": "boolean",
			"default": false
		},
		"interval": {
			"type": "number",
			"default": 6
		},
		"sideCardEnabled": {
			"type": "boolean",
			"default": true
		},
		"sideCardPostType": {
			"type": "string",
			"enum": [
				"post",
				"nntm_article",
				"nntm_publication",
				"nntm_talk",
				"nntm_video"
			],
			"default": "nntm_article"
		},
		"sideCardTaxonomy": {
			"type": "string",
			"default": "nntm_section"
		},
		"sideCardTermId": {
			"type": "number",
			"default": 0
		},
		"sideCardCtaLabel": {
			"type": "string",
			"default": "Xem thêm"
		},
		"quickLinksParentTermId": {
			"type": "number",
			"default": 0
		}
	},
	"editorScript": "file:./editor.js",
	"viewScript": "file:./view.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
