{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nntm/article-rows",
	"title": "Danh sách bài viết so le (Article Rows)",
	"category": "nntm",
	"icon": "align-pull-left",
	"description": "Danh sách bài viết xếp so le trái–phải theo giao diện phân mục. Có Yêu thích và phân trang tùy chọn.",
	"textdomain": "nntm",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"customClassName": true,
		"anchor": true
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Nguyên Thuỷ"
		},
		"postType": {
			"type": "string",
			"enum": [
				"nntm_article",
				"nntm_publication",
				"nntm_talk",
				"nntm_video",
				"post"
			],
			"default": "nntm_article"
		},
		"taxonomy": {
			"type": "string",
			"default": ""
		},
		"termId": {
			"type": "number",
			"default": 0
		},
		"postsPerPage": {
			"type": "number",
			"default": 5
		},
		"orderBy": {
			"type": "string",
			"enum": [
				"newest",
				"oldest",
				"title"
			],
			"default": "newest"
		},
		"startSide": {
			"type": "string",
			"enum": [
				"left",
				"right"
			],
			"default": "left"
		},
		"showCategory": {
			"type": "boolean",
			"default": false
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"showFavorite": {
			"type": "boolean",
			"default": true
		},
		"showPaging": {
			"type": "boolean",
			"default": false
		},
		"primaryCtaLabel": {
			"type": "string",
			"default": ""
		},
		"secondaryCtaLabel": {
			"type": "string",
			"default": "Xem thêm"
		}
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
