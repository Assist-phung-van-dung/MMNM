# Copy file nay thanh ".env" (cung thu muc) roi chinh gia tri that.
# ".env" khong duoc commit (xem .gitignore goc: mau ".env"); file mau nay
# thi commit duoc, chi de ghi lai cac bien co san — khong chua gia tri bi mat.
#
# Bat/tat tim bang anh va tim trong PDF. Doc boi nntm-search.php, dung CHUNG
# cho ca Docker lan khong-Docker (xem docs/10-ban-giao-tim-kiem.md muc
# "Bat/tat qua .env"). Gia tri: true / false. Khong ghi dong nao thi mac
# dinh la true (bat).
NNTM_SEARCH_IMAGE_ENABLED=true
NNTM_SEARCH_PDF_ENABLED=true
